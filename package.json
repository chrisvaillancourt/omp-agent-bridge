{
  "name": "omp-agent-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claude Code task delegation from interactive or non-interactive OMP using the official CLI",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "configure": "bun src/cli.ts configure",
    "check": "bun src/cli.ts check",
    "task": "bun src/cli.ts task",
    "test": "bun test",
    "typecheck": "tsc",
    "verify": "bun run typecheck && bun test && bun run check",
    "link": "omp plugin link ."
  },
  "omp": {
    "extensions": ["./src/extension.ts"]
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.2.11",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
